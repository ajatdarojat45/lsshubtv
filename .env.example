# rb-api-tester — template for .env.
# Setup: copy this file to `.env` (`cp .env.example .env`) and adjust values.
# `.env` is gitignored; this example file is safe to commit.
# Server-only vars are read at runtime; NEXT_PUBLIC_* vars are inlined into
# the browser bundle at build time (restart `next dev` / rebuild after edits).

# --- Upstream API endpoints ---------------------------------------------
# DataAPI: match list / match detail / stream detail.
RB_DATA_API=""
# LiveAPI: live match list / live match detail.
RB_LIVE_API=""

# --- Request identity headers (mimics the original Android app) ---------
RB_USER_AGENT=""
RB_ORIGIN=""

# --- SENSITIVE: AES-256-CTR signing material for play URLs ---------------
# Treat as secrets: override per deployment if needed. Format matters —
# RB_SIGN_KEY must be exactly 32 ASCII chars, RB_SIGN_IV exactly 16 ASCII chars.
RB_SIGN_KEY=""
RB_SIGN_IV=""

# --- Client-exposed defaults (NEXT_PUBLIC_* is inlined into the browser) --
# Default stream/channel identity used by the player.
NEXT_PUBLIC_RB_STREAM_ID=
NEXT_PUBLIC_RB_CHANNEL_ID=
# Default region for stream resolution.
NEXT_PUBLIC_RB_SITE_TYPE=
NEXT_PUBLIC_RB_CONTINENT=""
NEXT_PUBLIC_RB_COUNTRY=""
# Device registration identity (user-specific in production).
NEXT_PUBLIC_RB_DEVICE_ID=""
# Activation code (user-specific; may be left empty).
NEXT_PUBLIC_RB_ACTIVATION_CODE=""

# Contact email shown in the footer "Hubungi Kami" section.
# TODO: replace with your real contact email (.example is a reserved placeholder TLD).
RB_CONTACT_EMAIL=""
